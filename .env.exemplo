# Copie para .env e preencha. NUNCA publique este arquivo.
# OAuth (Google Cloud > APIs e serviços > Credenciais > ID do cliente OAuth tipo "App para computador")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Um refresh token por conta Google (gere com: node scripts/autorizar-conta.mjs)
GBP_REFRESH_TOKEN_PRINCIPAL=
# Opcional: só se usar negócios com "fonte": "places"
GOOGLE_PLACES_API_KEY=
